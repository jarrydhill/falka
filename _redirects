# Cloudflare Pages URL rewrites / redirects
#
# Range renamed 2026-04-20 to metre-based model names:
#   FALKA 01  → FALKA 845  (static at /falka-845.html)
#   FALKA 02  → FALKA 1050 (static at /falka-1050.html)
#   NEW      → FALKA 627  (static at /falka-627.html)
#
# The static product pages are now the canonical URLs. The /boats/:slug
# Sanity-backed catchall is kept for any boats added via CMS later but
# is not used by the main range.

# --- Legacy 301s: pre-rename slugs and old un-prefixed URLs ---
/falka-01               /falka-845.html         301
/falka-02               /falka-1050.html        301
/falka-03               /falka-1050.html        301
/vika-8                 /falka-845.html         301
/vika-81                /falka-1050.html        301
/falka-02-open          /falka-1050.html        301

/boats/vika-8           /falka-845.html         301
/boats/falka-02         /falka-1050.html        301
/boats/vika-81          /falka-1050.html        301
/boats/falka-02-open    /falka-1050.html        301
/boats/falka-01         /falka-845.html         301

# --- New canonical URLs also reachable via /boats/<slug> ---
/boats/falka-627        /falka-627.html         301
/boats/falka-845        /falka-845.html         301
/boats/falka-1050       /falka-1050.html        301

# --- Extension-less HTML files ---
/login.html             /login                  301
/boat.html              /boat                   301

# --- Sanity-backed catchall for any other boat slugs ---
# Resolves to the dynamic /boat template which loads the right boat
# from Sanity by URL slug via falka-cms.js.
/boats/:slug            /boat                   200
