# Cloudflare Pages URL rewrites / redirects
#
# Rules evaluated top-to-bottom; first match wins. Static files are
# checked before these rules (so /favicon.ico, /falka.css etc. are
# served as normal).

# --- Legacy 301 redirects for slugs renamed in Sanity ---
/falka-01        /vika-8           301
/falka-03        /vika-81          301

# --- Known non-boat pages. Must come BEFORE the catchall so they
# don't get swallowed and served as the boat template. ---
/login           /login.html       200

# --- Catch-all: any other single-segment path serves the boat
# template. Slug is extracted from the URL by falka-cms.js to
# fetch the right boat from Sanity. No .html on the target so
# Cloudflare's automatic HTML canonicalisation doesn't trigger. ---
/:slug           /boat             200
